---
import experience from '../../content/experience.json';

const name = "Jay Lord Dela Cruz";
const tagline = "Operations Architect | Customer Success Leader | CRM & Automation Specialist";
const summary = "10+ years across Operations Management, Customer Success, Technical Support, and Software Development Support — helping businesses turn broken processes into systems that run themselves.";
const email = "jay@backendoperators.com";
const whatsappNumber = "639454360341";
const whatsappDisplay = "+63 945 436 0341";

const builtCards = [
  {
    title: "Took a support team to Lean Six Sigma Green Belt–certified process discipline",
    body: "As SME Process Lead for a VPN software company — redesigned internal workflows and became primary CRM administrator (Zendesk, SnapEngage) for the whole support org.",
  },
  {
    title: "Built and led a technical support department from the ground up",
    body: "Early-stage fintech startup — promoted to department lead within three months, then technical support lead, becoming the bridge between customers, operations, and engineering.",
  },
  {
    title: "Fully automated a webinar company's operations",
    body: "Built end-to-end with Make.com — registration, reminders, attendance confirmation, and certificate generation, with zero manual steps.",
  },
  {
    title: "Ran agency-wide GoHighLevel operations",
    body: "Administrator for a white-labeled coaching organization — onboarding, snapshot management, automation deployment, and daily technical coaching for the client community.",
  },
  {
    title: "Delivered CRM and AI migrations across legal, real estate, medical, and coaching industries",
    body: "Including a full DRIP-to-GoHighLevel migration with membership and webhook automation, and voice AI / conversational AI systems for a real estate CRM provider.",
  },
];

const expertise = [
  { area: "Operations", items: "Process design, SOP creation, team leadership, performance management" },
  { area: "Customer Success", items: "Customer journey optimization, escalation management, retention support, community management" },
  { area: "CRM Systems", items: "GoHighLevel, Zendesk, HubSpot, Intercom, Freshdesk, SnapEngage, Monday.com, Jira, Make.com, Zapier, Retool" },
  { area: "Automation", items: "Lead management, email/SMS automation, webinar systems, membership systems, workflow engineering" },
  { area: "AI", items: "Conversational AI, AI voice, AI-powered customer engagement, AI workflow implementation" },
  { area: "Technical", items: "Troubleshooting, QA testing, bug reporting, product support, development collaboration" },
];

const industries = [
  "Automotive / Car Detailing",
  "Marketing Agencies",
  "AI Services Companies",
  "Medical & Surgical Services",
  "Psychology & Coaching",
  "Legal Industry",
  "Real Estate CRM Providers",
  "FinTech",
];

const showcaseItems = [
  {
    img: "/showcase-thrivecart-automation.svg",
    alt: "Diagram of a GoHighLevel automation that syncs ThriveCart purchases to CRM contacts",
    tag: "GoHighLevel · Workflow Automation",
    caption: "Every ThriveCart purchase auto-syncs to the CRM — matches or creates the contact, tags them as a purchaser, and logs up to 10 products with zero manual entry.",
  },
  {
    img: "/showcase-frn-knowledge-base.png",
    alt: "Family Referral Network self-serve knowledge base built inside GoHighLevel",
    tag: "GoHighLevel · Custom Menu Link",
    caption: "Built a self-serve onboarding hub inside GHL so clients stop pinging support for the basics.",
  },
  {
    img: "/showcase-frn-daily-call.png",
    alt: "FRN Daily Call scheduling page built inside GoHighLevel",
    tag: "GoHighLevel · Custom Menu Link",
    caption: "Gave clients an always-current daily support call schedule with one-click Zoom join — no more “what time is the call?” tickets.",
  },
  {
    img: "/showcase-cycl-toolbar.png",
    alt: "Cycl Sales Tools unified conversation toolbar",
    tag: "Cycl Sales Tools",
    caption: "Every SMS, email, WhatsApp, and social reply for a sub-account in one toolbar — no leaving the browser.",
  },
  {
    img: "/showcase-cycl-thread.png",
    alt: "Cycl Sales Tools reply-in-thread feature",
    tag: "Cycl Sales Tools",
    caption: "Replies join the existing thread across every channel, and call transcripts copy in one click.",
  },
  {
    img: "/showcase-cycl-booking.png",
    alt: "Cycl Sales Tools scheduling link copy tool",
    tag: "Cycl Sales Tools",
    caption: "Every active calendar link, one click to copy straight into a message — no digging through CRM settings.",
  },
  {
    img: "/showcase-lockedlawyered-chatbot.png",
    alt: "Locked & Lawyered AI legal assistant chatbot",
    tag: "AI Chatbot · Locked & Lawyered",
    caption: "A 24/7 legal-assistant chatbot that answers member questions on contracts, trademarks, and business protection — right in chat.",
  },
  {
    img: "/showcase-backendoperators-chatbot.png",
    alt: "BackendOperators AI support bot",
    tag: "AI Chatbot · BackendOperators",
    caption: "Built the AI support bot that answers pricing, timeline, and “what's included” questions instantly, any hour.",
  },
  {
    img: "/showcase-momshouse-chatbot.png",
    alt: "Mom's House AI Knowledge Base System chatbot",
    tag: "AI Chatbot · Family Referral Network",
    caption: "An AI knowledge-base assistant that answers client questions from a real knowledge base and knows when to hand off to a human.",
  },
  {
    img: "/showcase-ghl-new-customer-flow.png",
    alt: "GoHighLevel workflow diagram for a new customer nurture sequence with separate branches for each booking timeframe from tomorrow to 8 weeks out",
    tag: "GoHighLevel · Workflow Automation",
    caption: "An 11-branch nurture sequence that adapts SMS and email timing to each customer's exact booking date — built once, runs for every new customer automatically.",
  },
  {
    img: "/showcase-ghl-review-request.png",
    alt: "GoHighLevel workflow diagram for a review request automation that branches based on whether the customer's SMS reply is positive or negative",
    tag: "GoHighLevel · Workflow Automation",
    caption: "Automated review requests that read the customer's reply — positive responses get a review ask, negative ones get routed straight to a recovery message.",
  },
  {
    img: "/showcase-ghl-purchase-webhook.png",
    alt: "GoHighLevel workflow diagram showing a purchase webhook that finds or creates a contact, tags them, and updates purchase date fields",
    tag: "GoHighLevel · Workflow Automation",
    caption: "Every purchase webhook finds or creates the contact, tags them, and updates first/last purchase date fields automatically — no manual CRM entry.",
  },
  {
    img: "/showcase-ghl-weather-alert.png",
    alt: "GoHighLevel workflow diagram for a weather-based alert automation that checks upcoming bookings and sends a warning message",
    tag: "GoHighLevel · Workflow Automation",
    caption: "A daily weather check that automatically warns customers with upcoming outdoor appointments before bad weather hits.",
  },
  {
    img: "/showcase-ghl-lead-source-tag.png",
    alt: "GoHighLevel workflow diagram that auto-tags new contacts by UTM source: Facebook, Instagram, or Google Ads",
    tag: "GoHighLevel · Workflow Automation",
    caption: "Every new contact gets auto-tagged by ad source the moment they're created — accurate reporting with zero manual tagging.",
  },
  {
    img: "/showcase-make-project-intake.png",
    alt: "Make.com scenario diagram connecting a form response to Google Docs, Google Sheets, and automatic Slack channel creation",
    tag: "Make.com · Workflow Automation",
    caption: "A form submission creates the project doc, logs it to Sheets, and spins up a dedicated Slack channel with the right people invited — automatically.",
  },
  {
    img: "/showcase-make-deadline-router.png",
    alt: "Make.com scenario diagram with a router sending deadline notifications to four different Slack messages based on project stage",
    tag: "Make.com · Workflow Automation",
    caption: "One router reads project deadlines from Sheets and fires the right Slack alert for each stage — draft, revision, or final — with zero manual tracking.",
  },
  {
    img: "/showcase-make-webinar-registration.png",
    alt: "Make.com scenario diagram for a webinar registration automation with email verification, a router, and SMS or email plus calendar confirmation paths",
    tag: "Make.com · Webinar Automation",
    caption: "Registrants get verified, routed by device, and confirmed by SMS or email plus a calendar invite — a fully automated webinar registration system.",
  },
  {
    img: "/showcase-make-webinar-certificate.png",
    alt: "Make.com scenario diagram generating a certificate from a feedback form, uploading it to Google Drive, and emailing it via Gmail",
    tag: "Make.com · Webinar Automation",
    caption: "Feedback form submissions auto-generate a certificate, upload it to Drive, and email it to the attendee — no one touches a template by hand.",
  },
];

const stats = [
  { value: 10, suffix: "+", label: "Years Experience" },
  { value: 200, suffix: "+", label: "Onboarded Customers" },
  { value: 100, suffix: "+", label: "Automations Created" },
  { value: 50, suffix: "+", label: "AI Bots Created" },
  { value: 20, suffix: "+", label: "Trained Aspiring GoHighLevel Experts" },
];

const pageTitle = `${name} — Operations Architect & CRM Automation Specialist`;
const pageDescription = `${tagline}. ${summary}`;

const withBase = (path: string) => import.meta.env.BASE_URL + path.replace(/^\//, "");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="theme-color" content="#111827" />
		<link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="nav">
			<div class="nav-inner">
				<a class="brand" href="#top">{name}</a>
				<nav class="nav-links" aria-label="Section navigation">
					<a href="#about">About</a>
					<a href="#built">What I've Built</a>
					<a href="#showcase">Showcase</a>
					<a href="#experience">Experience</a>
					<a href="#expertise">Expertise</a>
					<a href="#contact">Contact</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<section id="top" class="hero">
				<div class="hero-inner">
					<div class="hero-text">
						<p class="kicker">Operations · CRM · Automation · AI</p>
						<h1>{name}</h1>
						<p class="tagline">{tagline}</p>
						<p class="hero-summary">{summary}</p>
						<div class="hero-cta">
							<a class="btn btn-primary" href={`mailto:${email}`}>Get in touch</a>
							<a class="btn btn-ghost" href="#experience">See the work &rarr;</a>
						</div>
					</div>
					<div class="hero-photo">
						<img src={withBase("/jay-photo.png")} alt={`Portrait of ${name}`} width="480" height="600" />
					</div>
				</div>
			</section>

			<section class="stats-band">
				<div class="section-inner">
					<div class="stats-grid">
						{stats.map((s) => (
							<div class="stat">
								<div class="stat-value" data-count-to={s.value} data-suffix={s.suffix}>0{s.suffix}</div>
								<div class="stat-label">{s.label}</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<section id="about" class="section anchor">
				<div class="section-inner narrow">
					<p class="label">About</p>
					<h2>The short version</h2>
					<div class="prose">
						<p>
							I didn't start in marketing or automation. I started fixing computers at an internet café, then spent a decade in technical support, escalation management, and operations leadership before automation and AI became the tools I used to solve the same problem I'd always solved: businesses drowning in manual work.
						</p>
						<p>
							I've been the first point of contact during a VPN outage. I've built the process that took a support team to Lean Six Sigma–certified discipline. I've automated an entire webinar business end to end. I've migrated legal firms off DRIP, rebuilt CRM stacks for real estate platforms, and stood up AI voice and conversational systems for companies that needed to scale support without scaling headcount.
						</p>
						<p>
							The thread through all of it: find where the process breaks, fix it, and build something that doesn't need to be fixed again.
						</p>
					</div>
				</div>
			</section>

			<section id="built" class="section alt anchor">
				<div class="section-inner">
					<p class="label">What I've built</p>
					<h2>Outcomes, not just tools</h2>
					<div class="card-grid">
						{builtCards.map((card) => (
							<div class="card">
								<h3>{card.title}</h3>
								<p>{card.body}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section id="showcase" class="section anchor">
				<div class="section-inner">
					<p class="label">Showcase</p>
					<h2 class="reveal-heading" data-reveal-heading>
						<span class="reveal-word">Systems</span> <span class="reveal-word">I've</span> <span class="reveal-word circled-word">shipped<svg class="scribble" data-scribble viewBox="0 0 170 74" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8,38 C6,20 24,7 55,6 C95,5 148,10 160,26 C170,40 150,58 110,64 C70,70 15,66 9,50 C6,42 20,34 45,32" fill="none" stroke="#14B8A6" stroke-width="4" stroke-linecap="round" /></svg></span>
					</h2>
					<p class="section-intro">Screenshots of automations, chatbots, and systems I've built and shipped for clients.</p>

					<div class="carousel" data-carousel>
						<div class="carousel-viewport">
							<div class="carousel-track" data-track>
								{showcaseItems.map((item) => (
									<div class="carousel-slide">
										<img src={withBase(item.img)} alt={item.alt} loading="lazy" />
										<div class="showcase-meta" data-meta>
											<p class="showcase-tag">{item.tag}</p>
											<p class="showcase-caption">{item.caption}</p>
										</div>
									</div>
								))}
							</div>
						</div>
						<button class="carousel-btn prev" data-prev type="button" aria-label="Previous slide">&larr;</button>
						<button class="carousel-btn next" data-next type="button" aria-label="Next slide">&rarr;</button>
						<div class="carousel-dots" data-dots>
							{showcaseItems.map((_, i) => (
								<button class="dot" data-dot={i} type="button" aria-label={`Go to slide ${i + 1}`}></button>
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="section anchor">
				<div class="section-inner narrow">
					<p class="label">Experience</p>
					<h2>Professional timeline</h2>
					<ol class="timeline">
						{experience.map((job) => (
							<li class="timeline-item">
								<div class="timeline-marker" aria-hidden="true"></div>
								<div class="timeline-content">
									<div class="timeline-head">
										<h3>{job.role}</h3>
										{job.period && <span class="timeline-period">{job.period}</span>}
									</div>
									<p class="timeline-org">{job.org}</p>
									<ul>
										{job.highlights.map((h: string) => <li>{h}</li>)}
									</ul>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section id="expertise" class="section alt anchor">
				<div class="section-inner">
					<p class="label">Core expertise</p>
					<h2>Where I add the most value</h2>
					<div class="card-grid">
						{expertise.map((e) => (
							<div class="card">
								<h3>{e.area}</h3>
								<p>{e.items}</p>
							</div>
						))}
					</div>

					<p class="label industries-label">Industries served</p>
					<ul class="tag-list">
						{industries.map((i) => <li class="tag">{i}</li>)}
					</ul>
				</div>
			</section>

			<section id="contact" class="section dark anchor">
				<div class="section-inner narrow center">
					<p class="label">Contact</p>
					<h2>Let's build something that works.</h2>
					<p class="contact-copy">
						Operations, CRM, and automation problems don't fix themselves. If you've got one, let's talk.
					</p>
					<div class="contact-cta">
						<a class="btn btn-primary" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">Message on WhatsApp</a>
						<a class="btn btn-ghost" href={`mailto:${email}`}>{email}</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<p>&copy; {new Date().getFullYear()} {name}. All rights reserved.</p>
			<p class="footer-credit">Powered by <a class="inline-link" href="https://backendoperators.com" target="_blank" rel="noopener noreferrer">BackendOperators</a></p>
		</footer>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		background: #14b8a6;
		color: #111827;
		padding: 10px 16px;
		z-index: 100;
		font-weight: 600;
	}
	.skip-link:focus {
		left: 12px;
		top: 12px;
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(250, 250, 248, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid #e5e7eb;
	}
	.nav-inner {
		max-width: 1040px;
		margin: 0 auto;
		padding: 14px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
	}
	.brand {
		font-family: "Manrope", sans-serif;
		font-weight: 800;
		font-size: 15px;
		color: #111827;
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
		font-size: 13.5px;
		font-weight: 500;
	}
	.nav-links a {
		color: #4b5563;
		text-decoration: none;
	}
	.nav-links a:hover {
		color: #14b8a6;
	}

	.anchor {
		scroll-margin-top: 76px;
	}

	.hero {
		background: #111827;
		color: #f6faf9;
		padding: 90px 24px;
	}
	.hero-inner {
		max-width: 1040px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 48px;
		align-items: center;
	}
	.hero-text {
		text-align: left;
	}
	.kicker {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #14b8a6;
		margin-bottom: 20px;
	}
	.hero h1 {
		font-family: "Manrope", sans-serif;
		font-weight: 800;
		font-size: clamp(32px, 5vw, 52px);
		letter-spacing: -0.02em;
		line-height: 1.08;
		margin: 0 0 16px;
	}
	.tagline {
		font-family: "Manrope", sans-serif;
		font-weight: 600;
		font-size: clamp(15px, 2vw, 18px);
		color: #14b8a6;
		margin: 0 0 20px;
	}
	.hero-summary {
		font-size: 16px;
		line-height: 1.7;
		color: #d1d5db;
		max-width: 480px;
		margin: 0 0 36px;
	}
	.hero-cta {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}
	.hero-photo {
		display: flex;
		justify-content: center;
	}
	.hero-photo img {
		width: 100%;
		max-width: 320px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 12px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 60px rgba(20, 184, 166, 0.2);
		border: 1px solid rgba(246, 250, 249, 0.1);
	}

	@media (max-width: 780px) {
		.hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.hero-text {
			text-align: center;
			order: 2;
		}
		.hero-photo {
			order: 1;
		}
		.hero-summary {
			margin-left: auto;
			margin-right: auto;
		}
		.hero-cta {
			justify-content: center;
		}
	}

	.btn {
		display: inline-block;
		font-weight: 600;
		font-size: 14.5px;
		padding: 13px 26px;
		border-radius: 4px;
		text-decoration: none;
	}
	.btn-primary {
		background: #14b8a6;
		color: #fff;
		box-shadow: 0 10px 24px rgba(20, 184, 166, 0.35), 0 0 30px rgba(20, 184, 166, 0.2);
	}
	.btn-primary:hover {
		background: #0f9488;
	}
	.btn-ghost {
		color: #f6faf9;
		border: 1px solid rgba(246, 250, 249, 0.3);
	}
	.btn-ghost:hover {
		border-color: #14b8a6;
		color: #14b8a6;
	}

	.section {
		padding: 88px 24px;
		background: #fafaf8;
	}
	.section.alt {
		background: #f3f4f1;
	}
	.section.dark {
		background: #111827;
		color: #f6faf9;
	}
	.section-inner {
		max-width: 1040px;
		margin: 0 auto;
	}
	.section-inner.narrow {
		max-width: 760px;
	}
	.section-inner.center {
		text-align: center;
	}

	.label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #14b8a6;
		margin-bottom: 16px;
	}
	.section h2 {
		font-family: "Manrope", sans-serif;
		font-weight: 700;
		font-size: clamp(24px, 3.5vw, 34px);
		letter-spacing: -0.01em;
		margin: 0 0 32px;
		color: inherit;
	}

	.section-intro {
		font-size: 15.5px;
		color: #6b7280;
		max-width: 560px;
		margin: -12px 0 40px;
		line-height: 1.6;
	}

	.carousel {
		position: relative;
	}
	.carousel-viewport {
		overflow: hidden;
		border-radius: 10px;
	}
	.carousel-track {
		display: flex;
		transition: transform 0.4s ease;
	}
	.carousel-slide {
		flex: 0 0 100%;
		min-width: 0;
		padding: 4px;
	}
	.carousel-slide img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: contain;
		background: #fff;
		border-radius: 10px;
		border: 1px solid #e5e7eb;
		box-shadow: 0 1px 2px rgba(17, 24, 39, 0.04), 0 10px 24px rgba(17, 24, 39, 0.07);
	}
	.showcase-meta {
		margin-top: 18px;
		text-align: left;
		max-width: 560px;
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.5s ease, transform 0.5s ease;
	}
	.showcase-meta.meta-in {
		opacity: 1;
		transform: translateY(0);
	}

	.reveal-heading {
		overflow: visible;
	}
