<script>
	document.querySelectorAll('[data-carousel]').forEach((carousel) => {
		const track = carousel.querySelector('[data-track]') as HTMLElement;
		const slides = Array.from(track.children);
		const dots = Array.from(carousel.querySelectorAll('[data-dot]'));
		const prevBtn = carousel.querySelector('[data-prev]');
		const nextBtn = carousel.querySelector('[data-next]');
		let index = 0;

		function update() {
			track.style.transform = `translateX(-${index * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
			slides.forEach((slide, i) => {
				const meta = slide.querySelector('[data-meta]');
				if (!meta) return;
				meta.classList.remove('meta-in');
				if (i === index) {
					requestAnimationFrame(() => requestAnimationFrame(() => meta.classList.add('meta-in')));
				}
			});
		}

		function goTo(i: number) {
			index = (i + slides.length) % slides.length;
			update();
		}

		prevBtn?.addEventListener('click', () => goTo(index - 1));
		nextBtn?.addEventListener('click', () => goTo(index + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		update();
	});

	// Cursor-follow glow
	const glow = document.querySelector('[data-cursor-glow]') as HTMLElement | null;
	if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
		let targetX = window.innerWidth / 2;
		let targetY = window.innerHeight / 2;
		let currentX = targetX;
		let currentY = targetY;

		window.addEventListener('mousemove', (e) => {
			targetX = e.clientX;
			targetY = e.clientY;
			glow.classList.add('is-active');
		});

		function raf() {
			currentX += (targetX - currentX) * 0.12;
			currentY += (targetY - currentY) * 0.12;
			glow.style.setProperty('--x', `${currentX}px`);
			glow.style.setProperty('--y', `${currentY}px`);
			requestAnimationFrame(raf);
		}
		requestAnimationFrame(raf);
	}

	// Stat count-up on scroll into view
	const statEls = document.querySelectorAll('[data-count-to]');
	const countUp = (el: Element) => {
		const target = Number(el.getAttribute('data-count-to'));
		const suffix = el.getAttribute('data-suffix') ?? '';
		const duration = 1200;
		const start = performance.now();

		function tick(now: number) {
			const progress = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			el.textContent = `${Math.round(target * eased)}${suffix}`;
			if (progress < 1) requestAnimationFrame(tick);
		}
		requestAnimationFrame(tick);
	};

	if (statEls.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						countUp(entry.target);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.4 }
		);
		statEls.forEach((el) => observer.observe(el));
	}

	// Heading word reveal + scribble draw-in
	const revealHeadings = document.querySelectorAll('[data-reveal-heading]');
	if (revealHeadings.length) {
		const headingObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						headingObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.5 }
		);
		revealHeadings.forEach((el) => headingObserver.observe(el));
	}
</script>
